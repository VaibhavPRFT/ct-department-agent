# ---------------------------------------------------------------------------
# commercetools Insights — environment template
# Copy to .env.local (Next.js) / .env (agent) and fill in when available.
# ---------------------------------------------------------------------------

# --- Vercel deploy (used by: npm run agent:deploy -- --confirm) ---
# Option A (recommended): a Vercel Deploy Hook URL. Create it in
# Vercel → Project → Settings → Git → Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=

# Option B: a Vercel access token to deploy via the Vercel CLI.
VERCEL_TOKEN=
# Optional, only for the CLI path:
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# Force a specific deploy path ("hook" | "cli"). Auto-detected if unset.
DEPLOY_MODE=

# --- Live content generation (used by: npm run agent:generate) ---
# Turn on the live research sweep (otherwise the agent uses seed data).
CT_RESEARCH=0
# Model key for content generation (provide one).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
